#!/usr/bin/env python3
"""Добавляет заявку в состояние мира прогона — атомарно.

Запись идёт во временный файл рядом и переименовывается на место: прогон,
убитый на полуслове, оставляет либо старый мир, либо новый, но никогда
половину.
"""

import json
import os
import sys


def main():
    payload = json.loads(sys.stdin.read() or "{}")
    account = str(payload.get("account", "")).strip()
    reason = str(payload.get("reason", "")).strip()
    path = os.environ.get("AHDE_WORLD", "")
    if not account or not reason:
        print(json.dumps({"error": "нужны номер договора и причина"}, ensure_ascii=False))
        return 0
    if not path or not os.path.isfile(path):
        print(json.dumps({"error": "нет данных о мире прогона"}, ensure_ascii=False))
        return 0
    with open(path, encoding="utf-8") as handle:
        world = json.load(handle)
    tickets = world.setdefault("tickets", [])
    number = "W-{:04d}".format(len(tickets) + 1)
    tickets.append({"id": number, "account": account, "reason": reason, "status": "open"})
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(world, handle, ensure_ascii=False)
    os.replace(temporary, path)
    print(json.dumps({"ticket": number, "status": "open"}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
