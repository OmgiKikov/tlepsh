#!/usr/bin/env python3
"""Читает состояние мира прогона и отвечает по одному абоненту.

Мир — это файл, путь к которому хост кладёт в AHDE_WORLD. Он описывает
конкретный кейс: у этого абонента такой тариф и такой баланс. Без мира
инструмент честно говорит, что данных нет, — выдумывать их нельзя.
"""

import json
import os
import sys


def main():
    payload = json.loads(sys.stdin.read() or "{}")
    account = str(payload.get("account", "")).strip()
    path = os.environ.get("AHDE_WORLD", "")
    if not account:
        print(json.dumps({"error": "не указан номер договора"}, ensure_ascii=False))
        return 0
    if not path or not os.path.isfile(path):
        print(json.dumps({"error": "нет данных о мире прогона"}, ensure_ascii=False))
        return 0
    with open(path, encoding="utf-8") as handle:
        world = json.load(handle)
    record = (world.get("accounts") or {}).get(account)
    if record is None:
        print(json.dumps({"error": "абонент {} не найден".format(account)}, ensure_ascii=False))
        return 0
    print(json.dumps({"account": account, **record}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
