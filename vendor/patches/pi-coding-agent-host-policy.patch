+/** Resolve the host-owned resume hint while preserving Pi's default when no override is provided. */
+export function resolveResumeCommand(
+	sessionManager: SessionManager,
+	resumeHint?: string | false,
+): string | undefined {
+	if (resumeHint === false) return undefined;
+	if (typeof resumeHint === "string") return resumeHint;
+	return formatResumeCommand(sessionManager);
+}
+
+const BUILTIN_SLASH_COMMAND_NAMES = new Set(BUILTIN_SLASH_COMMANDS.map((command) => command.name));
+
+function slashCommandName(text: string): string | undefined {
+	if (!text.startsWith("/")) return undefined;
+	const separator = text.search(/\s/);
+	return text.slice(1, separator === -1 ? undefined : separator);
+}
+
+function builtinSlashCommandName(text: string): string | undefined {
+	const name = slashCommandName(text);
+	if (name === undefined) return undefined;
+	return BUILTIN_SLASH_COMMAND_NAMES.has(name) ? name : undefined;
+}
+
+/** True for non-built-ins and for built-ins admitted by the host policy. */
+export function isBuiltinSlashCommandAllowed(text: string, allowed?: readonly string[]): boolean {
+	const name = builtinSlashCommandName(text);
+	return name === undefined || allowed === undefined || allowed.includes(name);
+}
+
+/** Project the built-in autocomplete surface through the same host policy used at dispatch. */
+export function getAllowedBuiltinSlashCommands(
+	allowed?: readonly string[],
+	preferredExtensions: ReadonlySet<string> = new Set(),
+) {
+	return BUILTIN_SLASH_COMMANDS.filter(
+		(command) => !preferredExtensions.has(command.name) && (allowed === undefined || allowed.includes(command.name)),
+	);
+}
+
+function getPreferredExtensionCommandNames(
+	configured: readonly string[] | undefined,
+	extensionRunner: ExtensionRunner,
+): ReadonlySet<string> {
+	if (!configured || configured.length === 0) return new Set();
+	return new Set(configured.filter((name) => extensionRunner.getCommand(name)?.name === name));
+}
+
 function hasDefaultModelProvider(providerId: string): providerId is keyof typeof defaultModelPerProvider {
 	return providerId in defaultModelPerProvider;
 }
